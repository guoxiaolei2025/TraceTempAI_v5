DEPARTMENT_GZJY_MICROBIOLOGY_API_KEY=your_api_key_here
# 广州金域感染中心
DEPARTMENT_GZJY_INFECTION_API_KEY=your_api_key_here

# ========== 大模型 AI 配置 ==========
# --- 主模型（通义千问 Qwen3.6） ---
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_API_KEY=your_dashscope_api_key_here
AI_MODEL=qwen3.6-flash
AI_TIMEOUT=300

# --- 备用模型（DeepSeek，主模型失败时自动切换） ---
AI_FALLBACK_API_URL=https://api.deepseek.com/chat/completions
AI_FALLBACK_API_KEY=your_deepseek_api_key_here
AI_FALLBACK_MODEL=deepseek-chat

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ========== 代理配置 ==========
PROXY_URL=none
NO_PROXY=

# ========== FastAPI 服务配置 ==========
FASTAPI_SERVER_HOST=0.0.0.0
FASTAPI_SERVER_PORT=8000

# ========== 安全配置 ==========
# 访问令牌：留空表示关闭认证（本地开发）；部署到公网时务必设置，
# 配置后所有 /api 请求必须携带 Authorization: Bearer <令牌> 或 X-API-Token: <令牌>
APP_ACCESS_TOKEN=
# 运行环境：development / production；生产环境隐藏异常详情，避免内部信息泄露
APP_ENV=development

# ========== 缓存配置 ==========
ENABLE_CACHE=true
CACHE_TTL=3600

# ========== 学科配置 ==========
DEPARTMENTS_CONFIG_PATH=config/departments.json